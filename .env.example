# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.
# Bun carga el archivo .env automáticamente al arrancar.

# Proveedor del modelo de lenguaje. Hoy solo está implementado "gemini" (es el valor por defecto).
LLM_PROVIDER=

# Modelo. Si lo dejas vacío se usa gemini-3.5-flash-lite (estable y económico).
# Alternativas más capaces: gemini-3.6-flash, gemini-3.8-flash.
LLM_MODEL=

# Clave de la API. Se crea en Google AI Studio (aistudio.google.com).
# También se acepta la variable GEMINI_API_KEY. No la pegues en ningún chat ni la subas al repositorio.
LLM_API_KEY=

# Topes de costo: evitan que un usuario gaste la clave sin límite.
# Pasos máximos entre el modelo y las herramientas en un turno
MAX_ITERACIONES_POR_TURNO=25
# Tokens máximos que puede consumir una sesión (cada paso reenvía el historial: un caso gasta unos 40 mil)
MAX_TOKENS_POR_SESION=300000
# Tokens máximos que el modelo puede escribir en una sola respuesta
MAX_TOKENS_SALIDA=2048
# Milisegundos de espera al modelo antes de rendirse
TIEMPO_LIMITE_LLM_MS=60000

# Puerto del servidor local
PORT=3000
